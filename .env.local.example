# ============================================================
# NETFLIX CLONE — Variables de Entorno
# Copiá este archivo a .env.local y completá los valores reales.
# NUNCA commitees .env.local — está en .gitignore.
# ============================================================

# --- TMDB API ---
# Obtené tu API Key en: https://www.themoviedb.org/settings/api
TMDB_API_KEY=tu_tmdb_api_key_aqui
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# --- MongoDB ---
# Connection string de MongoDB Atlas
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/netflix_db?retryWrites=true&w=majority

# --- NextAuth ---
# Generá un secret con: openssl rand -base64 32
NEXTAUTH_SECRET=tu_nextauth_secret_aqui
NEXTAUTH_URL=http://localhost:3000

# --- Google OAuth ---
# Configurá en: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_google_client_secret

# --- App Config ---
NEXT_PUBLIC_APP_NAME="Mi Netflix"
NEXT_PUBLIC_APP_URL=http://localhost:3000
